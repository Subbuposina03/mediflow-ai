# App Config
PROJECT_NAME="MediFlow AI"
API_V1_STR="/api/v1"

# Security
# Run: openssl rand -hex 32 to generate a secure secret key
SECRET_KEY="supersecretkeyformediflowaiproductionenvironment"

FRONTEND_URL=http://localhost:5173


# Database Configuration
# Set USE_SQLITE=true to bypass MySQL and run locally with SQLite
USE_SQLITE=true

MYSQL_SERVER=localhost
MYSQL_PORT=3306
MYSQL_DB=mediflow
MYSQL_USER=mediflow_user
MYSQL_PASSWORD=mediflow_secure_password
